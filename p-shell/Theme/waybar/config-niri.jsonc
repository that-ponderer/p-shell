{
    "layer": "top",
    "position":"top",
    "spacing": 4, 
    "margin-top":4,
    "margin-right":4,
    "margin-bottom":2,
    "margin-left":4,
   
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
        "custom/screenrec",
        "clock"
    ],

    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "disk",
        "backlight",
        "battery",
        "network",
        "network#eth",
        "bluetooth",
        "pulseaudio",
        "group/traygroup"
    ],

    "niri/workspaces": {
	   "format": "{index}",
	   "current-only": false,
       "on-click": "activate",
       "on-click-right": "deactivate",
       "sort-by-id": true
    }, 

    "niri/window": {
       "format": "{title}",
       "hide-empty-text": true 
    },

    "custom/screenrec" : {
        "exec": "${ThemePath}/Theme/niri/screen_record_monitor.sh",
        "format": "{text}",
        "interval": 1 ,
        "return-type": "json" ,
        "hide-empty-text": true ,
        "on-click": "pkill -SIGINT -f gpu-screen-recorder"

    },

    "clock": {
        "format": "{:%I:%M}",
        "format-alt": "{:%A, %B %d, %Y (%R)}",
        "tooltip": false,
        "actions":  {
                    "on-click-right": "mode"
        }
    },
    
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },

    "memory": {
        "format": "{}% "
    },

    "disk": {
    "interval": 30,
    "format": "{percentage_free}% 󰝰",
    "path": "/home"
    },

    "backlight": {
        "format": "{percent}% 󰖨",
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "interface": "wlan0",
        "interval":1,
        "format": "{bandwidthDownBytes} ",
        "tooltip-format": "[{essid}] freq: {frequency}GHz ss: {signaldBm}dBm",
        "format-disconnected":"",
        "format-disabled": ""
   },

   "network#eth": {
        "interface": "eth0",
        "interval":1,
        "format": "{bandwidthDownBytes} ",
        "tooltip": false,
        "format-disconnected":"",
        "format-disabled": ""
   },

    "bluetooth": {
        "format-disabled": "", 
        "format-no-controller": "",
        "format-off": "",
        "format-on": "[0] <span size='large'>󰂯</span>",
        "format-connected": "[{num_connections}] <span size='large'>󰂱</span>",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "[{device_alias}] {device_address}",
        "on-click": "GTK_THEME= overskride"
    },

    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰝟 {icon} {format_source}",
        "format-muted": "󰝟 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " " ,
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": ["", "", ""]
        },
        "on-click": "GTK_THEME= pwvucontrol"
    },

    "group/traygroup": {
        "orientation":"horizontal",
        "modules":["custom/tray-icon", "tray"],
        "drawer": {
            "transition-duration":100,
            "transition-left-to-right":false,
            "click-to-reveal":true
        },
        "tray": {
            "icon-size": 20,
            "spacing": 6
        }
    },

   "custom/tray-icon":{
    "format":"<span size='x-small'></span>",
    "tooltip-format":"I Use Artix btw!"
    }
}
