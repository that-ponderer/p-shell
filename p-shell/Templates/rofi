* {
    background-color: transparent;
    text-color: {15};
}

window {
    width: 730px;
    background-color: {0}c0;
    border: 2px solid;
    border-color: {15}80;
    padding: 16px;
    border-radius: 4px;
}
mainbox {
    spacing: 8px;
}
inputbar{
    background-image: linear-gradient(
        to bottom,
        {15}80,
        {15}01,
        {15}01,
        {15}01
    );
    background-color: {4}99;
    children: [textbox-seach-icon,entry];
    border: 2px solid;
    border-color: {15}80;
    border-radius: 4px;
}
textbox-seach-icon{
    expand: false;
    content: " ";
    margin: 6px 2px 6px 8px;
    background-color: transparent;
    color: {15};
    text-outline: true;
    text-outline-width: 1;
    text-outline-color: {15};
    padding: 0px 0px 0px 2px;
}
entry { 
    text-color: {15}; 
    padding: 5px 0px 0px 0px;
    background-color: transparent;
}
listview {
    padding: 6px 6px;
    lines: 8;
    background-image: linear-gradient(
        to bottom,
        {15}80,
        {15}01
    );
    background-color: {4}99;
    children: [textbox-seach-icon,entry];
    background-color: {5}33;
    border: 2px solid;
    border-color: {15}80;
    border-radius: 4px;
}
element {
    border-radius: 4px;
    padding: 2px 0px 2px 10px;
    margin: 1px 0px;
    border: 0;
    text-color: {15};
    background-color: {0}27;
}
element selected {
    background-image: linear-gradient(
        to bottom,
        #ffffff80,
        #ffffff01,
        #ffffff01
    );
    background-color: {14}b3;
    border: 2px solid;
    border-color: #ffffff80;
    text-color: {0};
}
element-text {
    background-color: #00000000; // This line is super imp , 
                                 // it hides the weird text background
    text-color:      inherit;
}    

