" Custom-Splash {{{

function! Center(lines)
  let width = &columns
  let centered = []
  for line in a:lines
    let pad = repeat(' ', max([0, (width - strdisplaywidth(line)) / 2]))
    call add(centered, pad . line)
  endfor
  return centered
endfunction

function! CenterVertical(lines)
  let height = &lines
  let top_padding = max([0, (height - len(a:lines)) / 2])
  let empty = repeat([''], top_padding)
  return empty + a:lines
endfunction

function! FillToScreen(start)
  let total = &lines
  let current = line('$')
  let needed = total - current
  if needed > 0
    call append(current, repeat([' '], needed))
  endif
endfunction

autocmd VimEnter *
  \ if !argc() |
  \   enew |
  \   setlocal buftype=nofile noswapfile nobuflisted |
  \   setlocal nonumber norelativenumber |
  \   let header = [
  \     '██████╗       ██╗   ██╗██╗███╗   ███╗',
  \     '██╔══██╗      ██║   ██║██║████╗ ████║',
  \     '██████╔╝█████╗██║   ██║██║██╔████╔██║',
  \     '██╔═══╝ ╚════╝╚██╗ ██╔╝██║██║╚██╔╝██║',
  \     '██║            ╚████╔╝ ██║██║ ╚═╝ ██║',
  \     '╚═╝             ╚═══╝  ╚═╝╚═╝     ╚═╝',
  \   ] |
  \   let splash = CenterVertical(Center(header)) |
  \   call setline(1, splash) |
  \   call FillToScreen(len(splash)) |
  \ endif

