window {
    location: south;
    y-offset: -30px;
    width: 600px;
    background-color: transparent;
    }
mainbox {
    spacing: 8px;
    background-image: linear-gradient(
        to top,
        #181825b3,
        #18182533
    );
    background-color: #cba6f733;
    border: 3px solid;
    border-color: #cdd6f480;
    border-radius: 8px;
    padding: 16px;
    }
inputbar{
    children: [
    textbox-header-A,
    textbox-header-B,
    textbox-header-C,
    prompt ,
    textbox-arrow-hollow
    ];
    spacing: 0px;
    background-color: transparent;
    border: 0px 0px 2px 0px solid;
    border-color: #cdd6f480;
    padding: 0px 0px 12px 0px;
}
prompt {
    background-color: transparent;
    color: #cdd6f4;
    padding: 0px 4px 0px 4px;
}
textbox-header-A{
    expand: false;
    content: "Current";
    color: #181825;
    background-color: #a6e3a1;
    padding: 0px 4px 0px 4px;
}
textbox-header-B{
    expand: false;
    content: "";
    color: #6c7086;
    background-color: #a6e3a1;
    padding: -1px 0px 0px 0px;
}
textbox-header-C{
    expand: false;
    content: "";
    color: #6c7086;
    background-color: transparent;
}
textbox-arrow-hollow{
    expand: false;
    content: "";
    color: #cdd6f4;
    background-color: transparent;
}
listview {
    padding: 6px 6px;
    lines:1;
    columns:10;
    background-color: transparent;
}
element {
    background-color: transparent;
    orientation: vertical;
}
element-icon {
    size: 105px;
    padding: 15px;
    background-color: transparent;
}
element selected {
    background-image: linear-gradient(
        to bottom,
        #cdd6f480,
        #cdd6f401
    );
    background-color: #89b4fa33;
    border: 2px solid;
    border-color: #cdd6f480;
    border-radius: 8px;
}
element-text {
    enabled:false;
}    