* {
    border-color: {4};
    text-selected: {0};
    text-idle: {8};
    text-unselected: {7};
    highlighter: {2};
    bg-color: {0}cc;
    color:@text-unselected;
    background-color:@bg-color;
    }

window {
    location: south;
    y-offset: -30px;
    width: 90%;
    background-color: @bg-color;
    border-radius: 8px;
    border: 2px solid;
    border-color: @border-color;
    }
mainbox {
    background-color: transparent;
    }
inputbar{
    enabled: false;
    }
listview {
    background-color: transparent;
    border-radius: 4px;
    padding: 0px 10px 15px 10px;
    lines:1;
    columns:10;
    }
element {
    background-color:inherit;
    orientation: vertical;
    background-color: transparent;
}
element-icon {
    size: 150px;
    background-color: transparent;
}
element selected {
    border: 0px 0px 4px 0px solid;
}
element-text {
    enabled:false;
}    

